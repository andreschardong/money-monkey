# Copy to .env (never committed).

# Optional: used only when Yahoo Finance fails for a symbol. Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Where people open Money Monkey; email links point here. The passkey domain is its host name without scheme or port.
FOLIO_PUBLIC_URL=http://localhost:8090
FOLIO_PASSKEY_DOMAIN=localhost
# true on a cloud host whose proxy terminates https (Railway, Cloud Run, Fly), so the app sees the real scheme and client address.
FOLIO_BEHIND_PROXY=false

# Cloud deployment (deploy/azure): the public host name, the Gmail address that sends sign-in emails, your Docker Hub user.
FOLIO_HOSTNAME=moneymonkey.example.com
FOLIO_GMAIL_USER=you@gmail.com
DOCKERHUB_USER=you

# Android app builds trusted for passkeys and sign-in links: package=SHA-256 fingerprint(s) of the signing
# certificates, comma-separated; several apps separated by semicolons. See android/README.md.
FOLIO_ANDROID_APPS=

# Who may use the app (comma-separated), enforced on every API request. Empty = anyone who can reach the app.
FOLIO_ALLOWED_EMAILS=you@example.com,partner@example.com

# Local inbox link shown after an email is sent (Mailpit). Leave empty once a real mail server is configured.
FOLIO_INBOX_URL=http://localhost:8025

# Mail server. The defaults send to the bundled Mailpit; for real email set your provider's SMTP details.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Money Monkey <folio@localhost>

# Gmail instead of Mailpit (an app password: Google Account -> Security -> 2-Step Verification -> App passwords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=StartTls
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=the 16-character app password
# SMTP_FROM=Money Monkey <you@gmail.com>
