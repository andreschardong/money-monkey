{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "LogFile": {
    "Path": "logs/folio-.log"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Folio": "Host=localhost;Port=5434;Database=folio;Username=folio;Password=folio"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Auth": {
    "PublicUrl": "http://localhost:8090",
    "PasskeyDomain": "localhost",
    "InboxUrl": "http://localhost:8025",
    "EmailsPerTenMinutes": 5,
    "AllowedEmails": ""
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "From": "Money Monkey <folio@localhost>"
  },
  "MarketData": {
    "TimeZone": "America/Toronto",
    "DailyRefreshTime": "17:30",
    "EnableScheduler": true,
    "RequestDelayMilliseconds": 350,
    "AlphaVantageApiKey": "",
    "AlphaVantageMaxCallsPerRun": 20
  }
}
